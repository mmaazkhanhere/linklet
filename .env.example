# Linklet Environment Configuration Template

# General Environment
ENVIRONMENT=development

# JWT Authentication
SECRET_KEY=change_this_to_a_secure_secret_key_in_production_32bytes_min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Connection (Async PostgreSQL)
# Local Docker Postgres:
DATABASE_URL=postgresql+asyncpg://linklet_user:linklet_password@localhost:5432/linklet
# Neon Serverless PostgreSQL (Production):
# DATABASE_URL=postgresql+asyncpg://user:pass@ep-cool-site-123456.us-east-2.aws.neon.tech/linklet?sslmode=require

# Frontend Base URL & API Endpoints
VITE_API_BASE_URL=http://localhost:8000/api/v1
BASE_URL=http://localhost:8000
